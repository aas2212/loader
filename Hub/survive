-- ============================================
-- UNLOAD CLEANUP
-- ============================================
local function unloadScript()
    _unloaded = true
    Library.Unloaded = true
    for char,_   in pairs(mobESPInstances)       do removeMobESP(char)          end
    for _,sys    in pairs(espSystems)            do for item,_ in pairs(sys.instances) do sys.remove(item) end end
    for player,_ in pairs(playerESPInstances)    do removePlayerESP(player)     end
    for struct,_ in pairs(structureESPInstances) do removeStructureESP(struct)  end
    for _,conn   in ipairs(connections) do
        if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
    end
    connections = {}
    stopAutoPickup(); stopBringPickup(); stopRepairAura(); stopInfiniteAmmo()
    stopFly(); destroyFlyMobileControls(); stopAutoSprint(); stopKillAura()
    stopAimbot(); stopBhop(); stopFunnyDance(); stopRemoteSpy()
    pcall(function() if setfpscap then setfpscap(60) end end)
    if fovCircle then pcall(function() fovCircle:Remove() end); fovCircle = nil end
    if Toggles.RemoveFog.Value  then disableRemoveFog()  end
    if Toggles.SpeedHack.Value  then
        local char = LocalPlayer.Character
        if char then local h = char:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed = originalValues.walkSpeed or 16 end end
    end
    if Toggles.Fullbright.Value then disableFullbright() end
    stopAutoBandage()
    stopAntiAFK()
    WindUI:Notify({ Title = "kreek store", Content = "Unloaded. Bye!", Duration = 3 })
    print("kreek store v8.2 unloaded.")
    Window:Destroy()
end

